# Copy to .env and fill from Firebase Console > Project Settings > Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=project-id.appspot.com
EXPO_PUBLIC_FIREBASE_SENDER_ID=sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-measurement-id
# Optional RTDB URL if you enable it:
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://project-id.firebaseio.com

# Map renderer: tiles = pure-JS OSM tiles (works on any build, no native modules).
# webview = interactive Leaflet map (needs react-native-webview in the native binary).
EXPO_PUBLIC_MAP_RENDERER=tiles

# Maps: the app uses free OpenStreetMap tiles (no key needed).
# Optional upgrade to native Google Maps (needs billing-enabled Cloud project):
# Google Cloud Console > enable "Maps SDK for Android" > Credentials > API key
# restricted to package com.lostphonefinder.app + your keystore SHA-1.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
